# Frontend environment configuration
# Copy to .env.local and update values as needed.

# Backend API URL — used by the dashboard to call FastAPI.
# Default (local dev): http://localhost:8000
# Docker Compose sets this automatically via docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API Key — must match GHOSTPROTOCOL_API_KEY in the backend .env
# Leave empty if authentication is disabled.
NEXT_PUBLIC_API_KEY=
