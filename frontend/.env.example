# Frontend environment configuration
# Copy to .env.local and update values as needed.

# Backend API URL — used by the Next.js API proxy to forward requests.
# Default (local dev): http://localhost:8000
# Docker Compose sets this automatically via docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side backend URL (used by the API proxy, not exposed to browser)
# Set this if the backend is on a different internal URL than NEXT_PUBLIC_API_URL
# BACKEND_API_URL=http://backend:8000

# API Key — injected server-side by the API proxy, NEVER exposed to the browser.
# Must match GHOSTPROTOCOL_API_KEY in the backend .env
GHOSTPROTOCOL_API_KEY=
