# Environment Configuration for GhostProtocol
# Copy this file to .env and fill in the values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# AWS Credentials (or use AWS CLI profile)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# Athena
ATHENA_DATABASE=cloudtrail_logs
ATHENA_OUTPUT_BUCKET=s3://your-athena-results-bucket/

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# LLM Setting (ollama, openai, or anthropic)
LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
LOG_LEVEL=INFO

# Environment (development, staging, production)
ENVIRONMENT=development

# Authentication — REQUIRED in production
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
GHOSTPROTOCOL_API_KEY=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
